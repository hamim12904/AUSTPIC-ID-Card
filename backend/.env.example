# Copy to .env and fill in. Never commit the real .env — it holds the JWT signing key.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/aust-pic

# Required. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Member photos (Cloudinary). Dashboard -> API keys. The image bytes live in
# Cloudinary and only a pointer to the asset is kept in MongoDB, but the API
# secret must stay on the server: never give it a VITE_ prefix, which would ship
# it to the browser. Without these the rest of the server runs and the photo
# endpoint answers 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. Photos are already delivered as authenticated assets over a URL
# signed with the API secret above, so an unsigned request for one is refused.
# Setting this adds an expiring __cld_token__ on top, which means even a URL
# that leaks stops resolving after ~15 minutes.
#
# Create the key in the Cloudinary dashboard: Settings -> Security ->
# "Authenticated delivery" -> Authentication key. It is a hex string; keep it
# server-side for the same reason as the API secret.
CLOUDINARY_AUTH_TOKEN_KEY=
